# Cross-compilation for the STM32G474 (Cortex-M4F, single-precision FPU, hard-float ABI).
#   -DSEMMC_PORTABLE_ONLY=ON      the portable core library only (portability and size check)
#   -DSEMMC_TARGET_STM32G474=ON   the linked target image (firmware/platform/stm32g4)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_C_COMPILER arm-none-eabi-gcc)
set(CMAKE_OBJCOPY arm-none-eabi-objcopy CACHE FILEPATH "objcopy")
set(CMAKE_SIZE arm-none-eabi-size CACHE FILEPATH "size")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard -ffunction-sections -fdata-sections")
