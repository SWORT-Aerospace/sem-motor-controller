CM_ "Generated by tools/gen_dbc.py from protocol/protocol.yaml (spec hash 193e498f6cb45df6). Block base 0x300 = controller calibration supervision.can_id_base. Do not edit.";
CM_ SG_ 768 first_fault "mc_fault_t, 0xFF = none";
CM_ SG_ 768 reset_reason "platform reset cause code";
CM_ BO_ 768 "Latched faults, first fault since reset and last MCU reset reason. Period 1.0 s + on change. CRC data id = (major << 11) | 0x300 (canonical number, not the bus id)";
CM_ SG_ 776 session_tag "tag assigned by controller in ctrl_session";
CM_ SG_ 776 limits_ref "low 4 bits of the sup_limits seq this request was computed against";
CM_ SG_ 776 src_time_ms "companion monotonic ms when the request was computed (wraps)";
CM_ BO_ 776 "Supervisory torque request (motor shaft). PROVISIONAL 50 Hz / 100 ms timeout, simulation only, pending hazard and latency analysis.
 Period 0.02 s. CRC data id = (major << 11) | 0x308 (canonical number, not the bus id)";
CM_ BO_ 777 "Supervisor-declared bounds; can only tighten controller limits. Period 0.1 s. CRC data id = (major << 11) | 0x309 (canonical number, not the bus id)";
CM_ SG_ 778 role "1 = energy supervisor";
CM_ BO_ 778 "Companion session announcement / handshake. Cannot arm or select a mode. Period 0.5 s. CRC data id = (major << 11) | 0x30A (canonical number, not the bus id)";
CM_ SG_ 784 state "mc_state_t";
CM_ SG_ 784 owner "0 none, 1 driver, 2 supervisor";
CM_ SG_ 784 sup_link "0 none, 1 hello, 2 established, 3 lost";
CM_ SG_ 784 boot_id "changes every controller boot";
CM_ SG_ 784 last_transition "mc_transition_t";
CM_ BO_ 784 "Operating state, owner, supervisor link and boot identity. Period 0.02 s. CRC data id = (major << 11) | 0x310 (canonical number, not the bus id)";
CM_ BO_ 785 "Requested (owner) vs accepted torque and reason bits (MC_R_*). Period 0.02 s. CRC data id = (major << 11) | 0x311 (canonical number, not the bus id)";
CM_ BO_ 786 "Wired driver controls AS SEEN BY THE CONTROLLER (report only; never an input). Period 0.02 s. CRC data id = (major << 11) | 0x312 (canonical number, not the bus id)";
CM_ SG_ 787 session_tag "0 = no session";
CM_ BO_ 787 "Handshake reply - session tag assigned to the echoed companion session. Period 0.5 s + on change. CRC data id = (major << 11) | 0x313 (canonical number, not the bus id)";
CM_ BO_ 792 "Rotor mechanical speed, measured q current, bus voltage. Period 0.01 s. CRC data id = (major << 11) | 0x318 (canonical number, not the bus id)";
CM_ BO_ 793 "d current, battery current (+ discharge), phase-measurement provenance, KCL residual. Period 0.01 s. CRC data id = (major << 11) | 0x319 (canonical number, not the bus id)";
CM_ BO_ 800 "Battery-side energy since controller boot and instantaneous battery power. Period 0.1 s. CRC data id = (major << 11) | 0x320 (canonical number, not the bus id)";
CM_ BO_ 801 "Temperatures and derating. Period 0.1 s. CRC data id = (major << 11) | 0x321 (canonical number, not the bus id)";
CM_ BO_ 802 "Per-signal validity nibbles (bit0 missing, bit1 stale, bit2 invalid/nonfinite/ out-of-range/integrity, bit3 saturated).
 Period 0.1 s. CRC data id = (major << 11) | 0x322 (canonical number, not the bus id)";
CM_ SG_ 808 mode "0 shadow, 1 advisory, 2 restricting (not permitted in v0.1)";
CM_ SG_ 808 observability "0 unknown, 1 observable, 2 ambiguous, 3 unobservable";
CM_ BO_ 808 "CSIA vehicle-adapter advisory. v0.1 = SHADOW ONLY: the controller logs and re-reports it but never changes a command because of it (ADR-0008).
 Period 0.1 s. CRC data id = (major << 11) | 0x328 (canonical number, not the bus id)";
CM_ BO_ 816 "Protocol, firmware and calibration identity. Period 1.0 s. CRC data id = (major << 11) | 0x330 (canonical number, not the bus id)";
